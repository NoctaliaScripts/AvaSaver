    -- The panel
    ------------------------------------------------------------------
    local function New(Class, Props, Parent)
        local Obj = Instance.new(Class)
        for k, v in pairs(Props) do
            Obj[k] = v
        end
        Obj.Parent = Parent
        return Obj
    end

