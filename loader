        Font = Enum.Font.GothamBold, TextSize = 22, TextColor3 = Color3.fromRGB(255, 160, 200), TextXAlignment = Enum.TextXAlignment.Left,
    }, Panel)

    local function Button(Text, Y, X, Width)
        local B = New("TextButton", {
            Position = UDim2.new(0, X or 16, 0, Y), Size = UDim2.new(0, Width or 228, 0, 34), BackgroundColor3 = Color3.fromRGB(75, 75, 75),
            BackgroundTransparency = 0.3, BorderSizePixel = 0, Text = Text, Font = Enum.Font.GothamMedium, TextSize = 16, TextColor3 = Color3.new(1, 1, 1),
        }, Panel)
        New("UICorner", { CornerRadius = UDim.new(0, 8) }, B)
        return B
    end
    local function Box(Placeholder, Y)
        local T = New("TextBox", {
            Position = UDim2.new(0, 16, 0, Y), Size = UDim2.new(0, 228, 0, 34), BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            BackgroundTransparency = 0.1, BorderSizePixel = 0, Text = "", PlaceholderText = Placeholder, ClearTextOnFocus = false,
            Font = Enum.Font.Gotham, TextSize = 15, TextColor3 = Color3.new(1, 1, 1), PlaceholderColor3 = Color3.fromRGB(150, 150, 150),
        }, Panel)
        New("UICorner", { CornerRadius = UDim.new(0, 8) }, T)
        return T
    end

    local Selected
    local LastPing = 0
    local Drop = Button("Select a player  v", 46)
    local List = New("ScrollingFrame", {
        Position = UDim2.new(0, 16, 0, 84), Size = UDim2.new(0, 228, 0, 150), BackgroundColor3 = Color3.fromRGB(20, 20, 20), BackgroundTransparency = 0,
        BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 5,
    }, Panel)
    New("UICorner", { CornerRadius = UDim.new(0, 8) }, List)
    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, List)

    local function DropText()
        Drop.Text = (Selected and Selected.Name or "Select a player") .. "  v"
    end

    RefreshList = function()
        for _, Child in ipairs(List:GetChildren()) do
            if Child:IsA("TextButton") or Child:IsA("TextLabel") then
                Child:Destroy()
            end
        end
        local Count = 0
        for _, Player in ipairs(Players:GetPlayers()) do
            if Roster[Player.UserId] and Player ~= LocalPlayer then
                Count += 1
                local B = New("TextButton", {
                    LayoutOrder = Count, Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, Text = Player.Name,
                    Font = Enum.Font.Gotham, TextSize = 15, TextColor3 = Color3.new(1, 1, 1), ZIndex = 6,
                }, List)
                B.MouseButton1Click:Connect(function()
                    Selected = Player
                    List.Visible = false
                    DropText()
                end)
            end
        end
        if Count == 0 then
            New("TextLabel", {
                LayoutOrder = 1, Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, Text = "Nobody else has the script",
                Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Color3.fromRGB(170, 170, 170), ZIndex = 6,
            }, List)
        end
        if Selected and not (Roster[Selected.UserId] and Selected.Parent) then -- left the server
            Selected = nil
            DropText()
        end
    end

    Drop.MouseButton1Click:Connect(function()
        List.Visible = not List.Visible
        if List.Visible then
            if os.clock() - LastPing > 5 then
                LastPing = os.clock()
                SendChat(".ping")
            end
            RefreshList()
        end
    end)

    -- Returns the picked player, or notifies and returns nil
    local function Pick()
        List.Visible = false
        if Selected and Selected.Parent then
            return Selected
        end
        Notify("Pick a player first")
    end

    for Index, Info in ipairs({ { "Freeze", "freeze" }, { "Kill", "kill" }, { "Kick", "kick" } }) do
        local Width = 72
        local B = Button(Info[1], 90, 16 + (Index - 1) * (Width + 6), Width)
        B.MouseButton1Click:Connect(function()
            local Player = Pick()
            if Player then
                SendChat("." .. Info[2] .. " " .. Player.Name)
            end
        end)
    end

    -- Emote: .e [emote name] user
    local EmoteBox = Box("Emote name (can be shortened)", 140)
    local EmoteButton = Button("Play emote", 180)
    EmoteButton.MouseButton1Click:Connect(function()
        local Player = Pick()
        local Emote = EmoteBox.Text:match("^%s*(.-)%s*$")
        if Player and Emote ~= "" then
            SendChat(".e " .. Emote .. " " .. Player.Name)
        end
    end)

    -- Load hat
    local HatBox = Box("Hat id", 232)
    local HatButton = Button("Load hat", 272)
    HatButton.MouseButton1Click:Connect(function()
        local Player = Pick()
        local Id = HatBox.Text:match("^%s*(%d+)%s*$")
        if not Id then
            Notify("Hat id must be numbers")
        elseif Player then
            SendChat(".gh " .. Player.Name .. " " .. Id)
        end
    end)

    -- Chat: makes their client say the message
    local ChatBox = Box("Message for them to chat", 324)
    local ChatButton = Button("Chat", 364)
    ChatButton.MouseButton1Click:Connect(function()
        local Player = Pick()
        local Message = ChatBox.Text:match("^%s*(.-)%s*$")
        if not Player or Message == "" then
            return
        end
        if IsOffensive(Message) then
            Notify("That message is blocked")
            return
        end
        SendChat(".say " .. Player.Name .. " " .. Message:sub(1, 200))
    end)

    -- Skin: one of your own saves, loaded on them
    local SkinBox = Box("Skin name (one of your saves)", 416)
    local SkinButton = Button("Load my skin on them", 456)
    SkinButton.MouseButton1Click:Connect(function()
        local Player = Pick()
        local Name = CleanName(SkinBox.Text)
        if Player and Name ~= "" then
            task.spawn(AdminLoadSkin, Player.Name, Name)
        end
    end)

    -- Send in chat: off keeps the commands out of your own chat
    local ToggleButton = Button("", 508)
    local function ToggleText()
        ToggleButton.Text = "Send in chat: " .. (SendInChat and "ON" or "OFF")
        ToggleButton.BackgroundColor3 = SendInChat and Color3.fromRGB(60, 140, 90) or Color3.fromRGB(75, 75, 75)
    end
    ToggleText()
    ToggleButton.MouseButton1Click:Connect(function()
        SendInChat = not SendInChat
        ToggleText()
    end)

    Connect(UserInputService.InputBegan, function(Input)
        if Input.UserInputType ~= Enum.UserInputType.Keyboard or Input.KeyCode ~= Enum.KeyCode.Eight or UserInputService:GetFocusedTextBox() then
            return
        end
        Panel.Visible = not Panel.Visible
        List.Visible = false
        if Panel.Visible then
            RefreshList()
        end
    end)
    RefreshList()
end)
if not AdminOk then
    warn("[Accessory Save] Admin setup failed: " .. tostring(AdminErr))
end

Genv.AccessorySaveStop = function()
    Alive = false
    for _, Connection in ipairs(Connections) do
        pcall(function() Connection:Disconnect() end)
    end
    if Frozen then
        pcall(function()
            local Character = LocalPlayer.Character
            if Character then
                for _, Part in ipairs(Character:GetDescendants()) do
                    if Part:IsA("BasePart") then
                        Part.Anchored = false
                    end
                end
            end
        end)
    end
    if FreezeConnection then
        pcall(function() FreezeConnection:Disconnect() end)
    end
    if PanelGui then
        PanelGui:Destroy()
    end
end

