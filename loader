        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Size = UDim2.new(0, 260, 0, 558),
        BackgroundColor3 = Color3.fromRGB(30, 30, 30), BackgroundTransparency = 0.15, BorderSizePixel = 0, Visible = false,
    }, Gui)
